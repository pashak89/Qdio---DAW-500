int TrackItem::mousePressEvent(QMouseEvent* event)
{

    if (!getTotalRect().contains(event->pos())) {
        return TrackItemEvent_NotSelect;
    }

    _isSelected = true;
    Q_EMIT sigSelectedChanged(_trackIndex);

    _mutex.lock();
    bool status = false;
    _selectedClipIndex = "";

    QMapIterator<QString, ClipItem*> i(_clipItems);
    while (i.hasNext()) {
        i.next();

        status = i.value()->mousePressEvent(event);
        if (status) {
            _selectedClipIndex = i.key();
        }
    }

    _mutex.unlock();

    bool keyFramesItem = _keyFramesItem->mousePressEvent(event);

    bool objectXSelected _objectPositionX->mousePressEvent(event);
    bool objectYSelected _objectPositionY->mousePressEvent(event);
    bool objectZSelected _objectPositionZ->mousePressEvent(event);

    double currentPix = event->pos().x();

    double final_xpos = 0;
    double final_ypos = 0;
    findSnap(currentPix, 0, final_xpos, final_ypos);

    // THis _currentIndicator will be change from clieArea::mousePressEvent
    //_currentIndicator = final_xpos / (double)_areaInfo->lastWidth() * _areaInfo->clipDuration() + _areaInfo->startTime();
    // Q_EMIT sigCurrentIndicatorChanged(_currentIndicator);

    if (_volumeAutomationItem->automation()->size() > 0 && _automationSelected == Automation::AutomationType_Volume) {
        double time = _volumeAutomationItem->automation()->pixel2Time(final_xpos);
        int index = _volumeAutomationItem->automation()->find_line(time);

        if (index >= _volumeAutomationItem->automation()->size()) {
            Automation::ALine aline = _volumeAutomationItem->automation()->getLine(_volumeAutomationItem->automation()->size() - 1);
            auto value = _volumeAutomationItem->yPixel2Value(aline.getY(time));
            _volumeAutomationItem->automation()->setAutomatedTrackValue(value);
        } else if (index < 0) {
            Automation::ALine aline = _volumeAutomationItem->automation()->getLine(0);
            auto value = _volumeAutomationItem->yPixel2Value(aline.getY(time));
            _volumeAutomationItem->automation()->setAutomatedTrackValue(value);
        } else {
            Automation::ALine aline = _volumeAutomationItem->automation()->getLine(index);

            auto value = _volumeAutomationItem->yPixel2Value(aline.getY(time));
            _volumeAutomationItem->automation()->setAutomatedTrackValue(value);
        }
    }

    int automation_event = TrackItemEvent_TrackSelect;
    if (rect().contains(event->pos())) {
        if (_panAutomationItem->automation()->size() > 0 && _automationSelected == Automation::AutomationType_Pan && _automationLaneEnabled) {
            double time = _panAutomationItem->automation()->pixel2Time(final_xpos);
            int index = _panAutomationItem->automation()->find_line(time);

            if (index >= _panAutomationItem->automation()->size()) {
                Automation::ALine aline = _panAutomationItem->automation()->getLine(_panAutomationItem->automation()->size() - 1);
                auto value = _panAutomationItem->yPixel2Value(aline.getY(time));
                _panAutomationItem->automation()->setAutomatedTrackValue(value);
            } else if (index < 0) {
                Automation::ALine aline = _panAutomationItem->automation()->getLine(0);
                auto value = _panAutomationItem->yPixel2Value(aline.getY(time));
                _panAutomationItem->automation()->setAutomatedTrackValue(value);
            } else {
                Automation::ALine aline = _panAutomationItem->automation()->getLine(index);

                auto value = _panAutomationItem->yPixel2Value(aline.getY(time));
                _panAutomationItem->automation()->setAutomatedTrackValue(value);
            }
        }

        if (_volumeAutomationItem->automation()->size() > 0 && _automationSelected == Automation::AutomationType_Volume && _automationLaneEnabled) {
            double time = _volumeAutomationItem->automation()->pixel2Time(final_xpos);
            int index = _volumeAutomationItem->automation()->find_line(time);

            if (index >= _volumeAutomationItem->automation()->size()) {
                Automation::ALine aline = _volumeAutomationItem->automation()->getLine(_panAutomationItem->automation()->size() - 1);
                auto value = _volumeAutomationItem->yPixel2Value(aline.getY(time));
                _volumeAutomationItem->automation()->setAutomatedTrackValue(value);
            } else if (index < 0) {
                Automation::ALine aline = _volumeAutomationItem->automation()->getLine(0);
                auto value = _volumeAutomationItem->yPixel2Value(aline.getY(time));
                _volumeAutomationItem->automation()->setAutomatedTrackValue(value);
            } else {
                Automation::ALine aline = _volumeAutomationItem->automation()->getLine(index);

                auto value = _volumeAutomationItem->yPixel2Value(aline.getY(time));
                _volumeAutomationItem->automation()->setAutomatedTrackValue(value);
            }
        }

        if (_automationSelected == Automation::AutomationType_Volume && _automationLaneEnabled) {

            int automation_event = _volumeAutomationItem->mousePressEvent(event);

            if (automation_event == AutomationItem::AutomationItemEvent_InnerSelect) {
                return TrackItemEvent_InnerSelect; // inner and point activated
            }
            if (automation_event == AutomationItem::AutomationItemEvent_OuterPointSelect) {
                return TrackItemEvent_OuterPointSelect; // outer activated
            }
        }

        if (_automationSelected == Automation::AutomationType_Pan && _automationLaneEnabled) {

            int automation_event = _panAutomationItem->mousePressEvent(event);

            if (automation_event == AutomationItem::AutomationItemEvent_InnerSelect) {
                return TrackItemEvent_InnerSelect; // inner and point activated
            }
            if (automation_event == AutomationItem::AutomationItemEvent_OuterPointSelect) {
                return TrackItemEvent_OuterPointSelect; // outer activated
            }
        }

    } else {

        if (_automationLaneModel->count() > 0) {

            auto automation_event1 = _volumeAutomationItem->mousePressEvent(event);
            auto automation_event2 = _panAutomationItem->mousePressEvent(event);

            if (automation_event1 == AutomationItem::AutomationItemEvent_InnerSelect) {
                automation_event = TrackItemEvent_InnerSelect;
            }
            if (automation_event1 == AutomationItem::AutomationItemEvent_OuterPointSelect) {
                automation_event = TrackItemEvent_OuterPointSelect;
            }

            if (automation_event2 == AutomationItem::AutomationItemEvent_InnerSelect) {
                automation_event = TrackItemEvent_InnerSelect;
            }
            if (automation_event2 == AutomationItem::AutomationItemEvent_OuterPointSelect) {
                automation_event = TrackItemEvent_OuterPointSelect;
            }

            if (automation_event1 == AutomationItem::AutomationItemEvent_Select) {
                automation_event = TrackItemEvent_VolumeAutomationSelect;
            }
            if (automation_event2 == AutomationItem::AutomationItemEvent_Select) {
                automation_event = TrackItemEvent_PanAutomationSelect;
            }

        } else {
        }
    }

    if (keyFramesItem == 0) {
        if (_selectedClipIndex != "") {
            return TrackItemEvent_ClipSelect;
        }
        return automation_event;
    } else {
        return TrackItemEvent_KeyFramesSelect;
    }
}

int TrackItem::hoverMoveEvent(QHoverEvent* event)
{

    QMapIterator<QString, ClipItem*> i(_clipItems);
    bool status = 0;
    _hoverClipIndex = "";
    while (i.hasNext()) {
        i.next();

        if (i.value()->hoverMoveEvent(event) == true) {
            status = 1;
            _hoverClipIndex = i.key();
        }
    }

    if (_automationLaneModel->count() == 0) {
        if (_volumeAutomationItem && _volumeAutomationItem->showEnvelopes() && _automationSelected == Automation::AutomationType_Volume) {
            status = _volumeAutomationItem->hoverMoveEvent(event);
        }
        if (_panAutomationItem && _panAutomationItem->showEnvelopes() && _automationSelected == Automation::AutomationType_Pan) {
            status = _panAutomationItem->hoverMoveEvent(event);
        }
    } else {
        bool status1 = _volumeAutomationItem->hoverMoveEvent(event);
        bool status2 = _panAutomationItem->hoverMoveEvent(event);
        return status1 || status2;
    }

    _keyFramesItem->hoverMoveEvent(event);

    _objectPositionX->hoverMoveEvent(event);
    _objectPositionY->hoverMoveEvent(event);
    _objectPositionZ->hoverMoveEvent(event);

    return status;
}

int TrackItem::mouseReleaseEvent(QMouseEvent* event)
{

    _keyFramesItem->mouseReleaseEvent(event);
    _objectPositionX->mouseReleaseEvent(event);
    _objectPositionY->mouseReleaseEvent(event);
    _objectPositionZ->mouseReleaseEvent(event);

    if (rect().contains(event->pos())) {

        if (_volumeAutomationItem && _volumeAutomationItem->showEnvelopes() && _automationSelected == Automation::AutomationType_Volume) {
            return _volumeAutomationItem->mouseReleaseEvent(event);
        }
        if (_panAutomationItem && _panAutomationItem->showEnvelopes() && _automationSelected == Automation::AutomationType_Pan) {
            return _panAutomationItem->mouseReleaseEvent(event);
        }

    } else {
        if (_rowsExpandedCount > 2) {
            bool status1 = _volumeAutomationItem->mouseReleaseEvent(event);
            bool status2 = _panAutomationItem->mouseReleaseEvent(event);
            return status1 || status2;
        }
    }

    return 0;
}

int TrackItem::mouseMoveEvent(QMouseEvent* event)
{

    int status = _keyFramesItem->mouseMoveEvent(event);

    _objectPositionX->mouseMoveEvent(event);
    _objectPositionY->mouseMoveEvent(event);
    _objectPositionZ->mouseMoveEvent(event);

    if (rect().contains(event->pos())) {
        if (_volumeAutomationItem && _volumeAutomationItem->showEnvelopes() && _automationSelected == Automation::AutomationType_Volume) {
            return _volumeAutomationItem->mouseMoveEvent(event);
        }
        if (_panAutomationItem && _panAutomationItem->showEnvelopes() && _automationSelected == Automation::AutomationType_Pan) {
            return _panAutomationItem->mouseMoveEvent(event);
        }
    } else {
        bool status1 = _volumeAutomationItem->mouseMoveEvent(event);
        bool status2 = _panAutomationItem->mouseMoveEvent(event);
        return status1 || status2;
    }

    return status;
}

int TrackItem::keyPressEvent(QKeyEvent* event)
{

    if (_rowsExpandedCount > 2) {
        if (_automationLaneModel->count() == 0) {
            if (_volumeAutomationItem && _volumeAutomationItem->showEnvelopes() && _automationSelected == Automation::AutomationType_Volume) {
                return _volumeAutomationItem->keyPressEvent(event);
            }
            if (_panAutomationItem && _panAutomationItem->showEnvelopes() && _automationSelected == Automation::AutomationType_Pan) {
                return _panAutomationItem->keyPressEvent(event);
            }
        } else {

            bool status1 = _volumeAutomationItem->keyPressEvent(event);
            bool status2 = _panAutomationItem->keyPressEvent(event);
            return status1 || status2;
        }
    }
    return 0;
}

int TrackItem::keyReleaseEvent(QKeyEvent* event)
{

    if (_automationLaneModel->count() == 0) {
        if (_volumeAutomationItem && _volumeAutomationItem->showEnvelopes() && _automationSelected == Automation::AutomationType_Volume) {
            return _volumeAutomationItem->keyReleaseEvent(event);
        }
        if (_panAutomationItem && _panAutomationItem->showEnvelopes() && _automationSelected == Automation::AutomationType_Pan) {
            return _panAutomationItem->keyReleaseEvent(event);
        }
    } else {
        bool status1 = _volumeAutomationItem->keyReleaseEvent(event);
        bool status2 = _panAutomationItem->keyReleaseEvent(event);
        return status1 || status2;
    }
    return 0;
}

