{
    if (_automationLaneModel->count() == 0) {
        return automationItem()->createCopyList(selectedArea);
    } else {

        bool status1 = _volumeAutomationItem->createCopyList(selectedArea);
        bool status2 = _panAutomationItem->createCopyList(selectedArea);
        return status1 || status2;
    }
}

int TrackItem::insertCopiedList()
{

    if (_automationLaneModel->count() == 0) {
        if (automationItem()->insertCopiedList()) {
            return -1;
        }
        return -2;
    } else {

        int index = -2;
        if (_volumeAutomationItem->insertCopiedList()) {
            if (_volumeAutomationItem->automation()->getSubTrackIndex() > index) {
                index = _volumeAutomationItem->automation()->getSubTrackIndex();
            }
        }
        if (_panAutomationItem->insertCopiedList()) {
            if (_panAutomationItem->automation()->getSubTrackIndex() > index) {
                index = _panAutomationItem->automation()->getSubTrackIndex();
            }
        }
        return index;
    }
}

void TrackItem::setCopyList(const QList<Automation::ALine>& copyList, int subTrackIndex)
{

    if (_automationLaneModel->count() == 0) {
        qDebug() << "setCopyList1" << _automationSelected << copyList.size();
        automationItem()->automation()->setCopyList(copyList);
    } else {

        if (subTrackIndex < 0) {
            qDebug() << "setCopyList2" << _automationSelected;
            automationItem()->automation()->setCopyList(copyList);
        } else {
            if (_automationLaneModel->getItem(subTrackIndex)->automationLaneControl == "Volume") {
                _volumeAutomationItem->automation()->setCopyList(copyList);
            } else {
                _panAutomationItem->automation()->setCopyList(copyList);
            }
        }
    }
}

void TrackItem::setCopyList2(const QList<Automation::ALine>& copyList, Automation::AutomationType type)
{

    qDebug() << "setCopyList2" << type << copyList.size();
    if (type == Automation::AutomationType_Pan) {
        _panAutomationItem->automation()->setCopyList(copyList);
    }
    if (type == Automation::AutomationType_Volume) {
        _volumeAutomationItem->automation()->setCopyList(copyList);
    }
}

