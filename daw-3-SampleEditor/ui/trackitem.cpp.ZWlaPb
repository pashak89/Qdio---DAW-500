{
}

QJsonArray TrackItem::deleteSelectedArea(SelectedArea selectedRect)
{

    QJsonArray jArray;
    qDebug() << "deleteSelectedArea" << selectedRect.area() << rect();
    if (selectedRect.area().left() >= 0 && selectedRect.area().right() >= 0 && selectedRect.area().left() != selectedRect.area().right() && (rect().top() >= selectedRect.area().top() && rect().bottom() <= selectedRect.area().bottom())) {

        auto list = findOverlayItems(selectedRect.area().left(), selectedRect.area().right());

        qDebug() << "deleteSelectedArea1" << selectedRect.area().left() << selectedRect.area().right();
        for (int i = 0; i < list.size(); i++) {

            if (selectedRect.area().right() <= _clipItems[list[i]]->sampleClip()->startTime() || selectedRect.area().left() >= _clipItems[list[i]]->sampleClip()->endTime()
                || selectedRect.area().top() >= _clipItems[list[i]]->rect().bottom() || selectedRect.area().bottom() <= _clipItems[list[i]]->rect().top()) {

                qDebug() << "deleteSelectedArea2";
            } else {

                qDebug() << "deleteSelectedArea3";
                auto array = cutClipItem(list[i], selectedRect.area().left(), selectedRect.area().right());
                jArray.append(array);
            }
        }
    }

    return jArray;
}

QVector<TrackItem::CopyItem> TrackItem::copySelectedArea(SelectedArea selectedRect)
{
    QVector<TrackItem::CopyItem> list;

    qDebug() << "copySelectedArea1;" << selectedRect.area() << rect();
    if (selectedRect.area().left() >= 0 && selectedRect.area().right() >= 0 && selectedRect.area().left() != selectedRect.area().right() && (rect().top() >= selectedRect.area().top() && rect().bottom() <= selectedRect.area().bottom())) {

        QMapIterator<QString, ClipItem*> i(_clipItems);
        while (i.hasNext()) {
            i.next();

            if (selectedRect.area().right() <= i.value()->sampleClip()->startTime() || selectedRect.area().left() >= i.value()->sampleClip()->endTime()
                || selectedRect.area().top() >= i.value()->rect().bottom() || selectedRect.area().bottom() <= i.value()->rect().top()) {

                qDebug() << "copySelectedArea2";
            } else {

                qDebug() << "copySelectedArea3";
                auto cloneditem = _clipItems[i.key()]->clone(_track, true);

                cloneditem->setAutomationLaneModel(_automationLaneModel);
                cloneditem->setRowsExpandedCount(_rowsExpandedCount);

                list.append(CopyItem {
                    selectedRect.area().left(),
                    selectedRect.area().right(),
                    _clipItems[i.key()]->sampleClip()->endTime() - _clipItems[i.key()]->sampleClip()->startTime(),
                    selectedRect.area().left() - _clipItems[i.key()]->sampleClip()->startTime(),
                    _clipItems[i.key()]->sampleClip()->endTime() - selectedRect.area().right(),
                    _trackIndex,
                    cloneditem, selectedRect.area().height() });
            }
        }

        if (list.size() == 0) {

            qDebug() << "copySelectedArea4";
            list.append(CopyItem { -1, -1, -1, -1, -1, _trackIndex, nullptr, selectedRect.area().height() });
        }
    }
    return list;
}

QVector<ClipItem*> TrackItem::copyAllClipItems()
{
    QVector<ClipItem*> list;

    QMapIterator<QString, ClipItem*> i(_clipItems);
    while (i.hasNext()) {
        i.next();
        list.append(_clipItems[i.key()]->clone(_track, true));
    }
    return list;
}

