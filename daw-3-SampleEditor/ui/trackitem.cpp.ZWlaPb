bool TrackItem::removedCopiedList(SelectedArea selectedArea)
{

    if (_automationLaneModel->count() == 0) {
        return automationItem()->removedCopiedList(selectedArea);
    } else {
        qDebug() << "removedCopiedList" << selectedArea.area();

        for (int i = -1; i < _automationLaneModel->count(); i++) {
            if (i == -1) {
                automationItem()->removedCopiedList(selectedArea);
            } else {
                if (_automationLaneModel->getItem(i)->automationLaneControl == "Volume") {
                    _volumeAutomationItem->removedCopiedList(selectedArea);
                } else {
                    _panAutomationItem->removedCopiedList(selectedArea);
                }
            }
        }
        return true;
    }
}
