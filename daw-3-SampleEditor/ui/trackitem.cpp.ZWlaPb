void TrackItem::drawTitleLine(IPainter* painter)
{
    auto offset = 0;

    painter->beginPath();
    painter->setFillStyle("#000000");
    painter->setStrokeStyle("#000000");
    painter->drawLine(rect().x(), rect().y() + _areaInfo->titleHeight() + offset, rect().x() + rect().width(), rect().y() + _areaInfo->titleHeight() + offset);
    painter->stroke();
}

void TrackItem::drawSelectedArea(IPainter* painter)
{

    auto offset = 0;

    auto _lastWidth = _areaInfo->lastWidth();
    auto _startTime = _areaInfo->startTime();
    auto _clipDuration = _areaInfo->clipDuration();

    auto _selectedArea = _areaInfo->selectionArea()->area();

    if (_selectedArea.left() >= 0 && _selectedArea.right() >= 0 && _selectedArea.right() != _selectedArea.left()) {

        painter->beginPath();
        painter->setFillStyle("#880000FF");
        painter->setStrokeStyle("#880000FF");

        double startX = ((_selectedArea.left() - _startTime) / (double)_clipDuration) * _lastWidth;
        double endX = ((_selectedArea.right() - _startTime) / (double)_clipDuration) * _lastWidth;
        if (_selectedArea.left() < _selectedArea.right()) {
            startX = ((_selectedArea.left() - _startTime) / (double)_clipDuration) * _lastWidth;
            endX = ((_selectedArea.right() - _startTime) / (double)_clipDuration) * _lastWidth;
        } else {
            endX = ((_selectedArea.left() - _startTime) / (double)_clipDuration) * _lastWidth;
            startX = ((_selectedArea.right() - _startTime) / (double)_clipDuration) * _lastWidth;
        }

        QRect drawAreaTotal = QRect(startX, getTotalRect().top() + offset, (endX - startX), getTotalRect().height());
        QRect drawArea = QRect(startX, rect().top() + offset, (endX - startX), rect().height());
        QRect drawArea1 = QRect();
        QRect drawArea2 = QRect();

        if (_automationLaneModel->count() >= 1) {

            auto top = rect().top() + _rowsExpandedCount * _areaInfo->titleHeight() + _areaInfo->seperatorHeight();
            auto H = _automationLaneModel->totalRowCountBefore2(0) * _areaInfo->titleHeight() + 0 * _areaInfo->seperatorHeight();
            auto tempRect = rect();
            tempRect.setTop(top + H + offset);
            tempRect.setHeight(_automationLaneModel->getItem(0)->automationLaneRowCount * _areaInfo->titleHeight());

            drawArea1 = QRect(startX, tempRect.top(), (endX - startX), tempRect.height());

            if (_automationLaneModel->count() >= 2) {
                H = _automationLaneModel->totalRowCountBefore2(1) * _areaInfo->titleHeight() + 1 * _areaInfo->seperatorHeight();
                tempRect = rect();
                tempRect.setTop(top + H + offset);
                tempRect.setHeight(_automationLaneModel->getItem(1)->automationLaneRowCount * _areaInfo->titleHeight());

                drawArea2 = QRect(startX, tempRect.top(), (endX - startX), tempRect.height());
            }
        }

        if (!(_areaInfo->selectionArea()->isClipSelectedAtLast || _areaInfo->selectionArea()->isClipSelectedAtFirst)) {
            if (_automationLaneEnabled == true) {

                drawArea = QRect(startX, rect().top() + _areaInfo->titleHeight() + offset, (endX - startX), rect().height() - _areaInfo->titleHeight());
            }
        }
        if (_automationLaneEnabled == true) {
            if (_areaInfo->selectionArea()->isClipSelectedAtLast == false) {

                drawArea = QRect(startX, rect().top() + _areaInfo->titleHeight() + offset, (endX - startX), rect().height() - _areaInfo->titleHeight());
            }
        } else {

            if (!(_areaInfo->selectionArea()->isClipSelectedAtLast || _areaInfo->selectionArea()->isClipSelectedAtFirst)) {

                drawArea = QRect();
            }
        }

        if (_areaInfo->selectionArea()->firstTrackIndex() <= _trackIndex && _trackIndex <= _areaInfo->selectionArea()->lastTrackIndex()) {

            if (_areaInfo->selectionArea()->firstTrackIndex() == _trackIndex && _areaInfo->selectionArea()->lastTrackIndex() != _trackIndex) {

                if (_automationLaneModel->count() > 0 && _automationLaneEnabled == true) {

                    if (_areaInfo->selectionArea()->isClipSelectedAtLast == true && _areaInfo->selectionArea()->isClipSelectedAtFirst == true) {

                        painter->fillRect(drawAreaTotal);
                        painter->stroke();
                    } else {

                        if (_areaInfo->selectionArea()->_firstSubTrackIndex == -1) {
                            if (!drawArea.isNull()) {
                                painter->fillRect(drawArea);
                            }

                            if (!drawArea1.isNull()) {
                                painter->fillRect(drawArea1);
                            }
                            if (!drawArea2.isNull()) {
                                painter->fillRect(drawArea2);
                            }
                            painter->stroke();
                        }
                        if (_areaInfo->selectionArea()->_firstSubTrackIndex == 0) {
                            if (!drawArea1.isNull()) {
                                painter->fillRect(drawArea1);
                            }
                            if (!drawArea2.isNull()) {
                                painter->fillRect(drawArea2);
                            }
                            painter->stroke();
                        }
                        if (_areaInfo->selectionArea()->_firstSubTrackIndex == 1) {
                            if (!drawArea2.isNull()) {
                                painter->fillRect(drawArea2);
                            }
                            painter->stroke();
                        }
                    }

                } else {
                    if (!drawArea.isNull()) {
                        painter->fillRect(drawArea);
                    }
                    painter->stroke();
                }

            } else if (_areaInfo->selectionArea()->lastTrackIndex() == _trackIndex && _areaInfo->selectionArea()->firstTrackIndex() != _trackIndex) {

                if (_automationLaneModel->count() > 0 && _automationLaneEnabled == true) {

                    if (_areaInfo->selectionArea()->isClipSelectedAtLast == true || _areaInfo->selectionArea()->isClipSelectedAtFirst == true) {
                        painter->fillRect(drawAreaTotal);
                        painter->stroke();
                    } else {
                        if (_areaInfo->selectionArea()->_lastSubTrackIndex == -1) {
                            if (!drawArea.isNull()) {
                                painter->fillRect(drawArea);
                            }
                            painter->stroke();
                        }
                        if (_areaInfo->selectionArea()->_lastSubTrackIndex == 0) {
                            if (!drawArea.isNull()) {
                                painter->fillRect(drawArea);
                            }
                            if (!drawArea1.isNull()) {
                                painter->fillRect(drawArea1);
                            }

                            painter->stroke();
                        }
                        if (_areaInfo->selectionArea()->_lastSubTrackIndex == 1) {
                            if (!drawArea.isNull()) {
                                painter->fillRect(drawArea);
                            }
                            if (!drawArea1.isNull()) {
                                painter->fillRect(drawArea1);
                            }
                            if (!drawArea2.isNull()) {
                                painter->fillRect(drawArea2);
                            }
                            painter->stroke();
                        }
                    }

                } else {

                    if (!drawArea.isNull()) {
                        painter->fillRect(drawArea);
                    }
                    painter->stroke();
                }

            } else if (_areaInfo->selectionArea()->lastTrackIndex() == _trackIndex && _areaInfo->selectionArea()->firstTrackIndex() == _trackIndex) {

                if (_automationLaneModel->count() > 0 && _automationLaneEnabled == true) {

                    if (_areaInfo->selectionArea()->isClipSelectedAtLast == true || _areaInfo->selectionArea()->isClipSelectedAtFirst == true) {
                        painter->fillRect(drawAreaTotal);
                        painter->stroke();
                    } else {
                        for (int i = -1; i <= 1; i++) {
                            if (i >= _areaInfo->selectionArea()->_firstSubTrackIndex && i <= _areaInfo->selectionArea()->_lastSubTrackIndex) {
                                if (i == -1) {
                                    if (!drawArea.isNull()) {
                                        painter->fillRect(drawArea);
                                    }
                                    painter->stroke();
                                }
                                if (i == 0) {
                                    if (!drawArea1.isNull()) {
                                        painter->fillRect(drawArea1);
                                    }
                                    painter->stroke();
                                }
                                if (i == 1) {
                                    if (!drawArea2.isNull()) {
                                        painter->fillRect(drawArea2);
                                    }
                                    painter->stroke();
                                }
                            }
                        }
                    }

                } else {
                    if (!drawArea.isNull()) {
                        painter->fillRect(drawArea);
                    }
                    painter->stroke();
                }

            } else {

                if (_areaInfo->selectionArea()->isClipSelectedAtLast == true || _areaInfo->selectionArea()->isClipSelectedAtFirst == true) {
                    painter->fillRect(drawAreaTotal);
                    painter->stroke();
                } else {
                    if (_automationLaneModel->count() > 0 && _automationLaneEnabled == true) {
                        if (!drawArea.isNull()) {
                            painter->fillRect(drawArea);
                        }

                        if (!drawArea1.isNull()) {
                            painter->fillRect(drawArea1);
                        }
                        if (!drawArea2.isNull()) {
                            painter->fillRect(drawArea2);
                        }
                        painter->stroke();
                    } else {
                        if (!drawArea.isNull()) {
                            painter->fillRect(drawArea);
                        }
                        painter->stroke();
                    }
                }
            }
        }
    }
}

void TrackItem::draw(IPainter* painter)
{

    int T = rect().top();
    int B = rect().bottom();
    auto lastWidth = _areaInfo->lastWidth();
    if (lastWidth <= 0) {
        return;
    }

    drawIndicator(painter);
    painter->save();
    painter->beginPath();
    //    painter->setStrokeStyle(QNanoColor(_titleColor.red(), _titleColor.green(), _titleColor.blue(), 40));
    //    painter->setFillStyle(QNanoColor(_titleColor.red(), _titleColor.green(), _titleColor.blue(), 40));
    //    painter->fillRect(_rect);

    //    painter->setStrokeStyle(QNanoColor(_titleColor.red(), _titleColor.green(), _titleColor.blue(), 100));
    //    painter->setFillStyle(QNanoColor(_titleColor.red(), _titleColor.green(), _titleColor.blue(), 100));
    //    painter->fillRect(getTotalRect());

    painter->setStrokeStyle("#2f3032");
    painter->setFillStyle("#2f3032");

    auto offset = 0;

    if (_isMasterTrack) {
        painter->fillRect(rect().x(), offset + totalRect().top(), rect().width(), _areaInfo->seperatorHeight());
    } else {
        //        qDebug() << "rect().height() + rect().y() - _areaInfo->seperatorHeight()"
        //                 << rect().height() + rect().y() - _areaInfo->seperatorHeight() << _trackIndex << rect().height() << rect().top() << rect() << _rect;

        painter->fillRect(rect().x(), offset + rect().y() + rect().height() - _areaInfo->seperatorHeight(), rect().width(), _areaInfo->seperatorHeight());
    }

    painter->restore();

    if (_rowsExpanded && _automationLaneEnabled) {
        drawAutomationLane(painter);
    }

    drawClips(painter);

    drawSelectedArea(painter);

    if (_volumeAutomationItem->showEnvelopes()) {
        drawTitleLine(painter);
    }

    if (_automationLaneModel->count() == 0) {
        if (_volumeAutomationItem && _volumeAutomationItem->showEnvelopes() == true && _automationSelected == Automation::AutomationType_Volume && _rowsExpandedCount > 2) {
            QRect tempRect = _rect;
            tempRect.setTop(offset + rect().top() + _areaInfo->titleHeight());
            tempRect.setHeight(_areaInfo->titleHeight() * (_rowsExpandedCount - 1));
            _volumeAutomationItem->setRect(tempRect);
            _volumeAutomationItem->automation()->update(tempRect);
            _volumeAutomationItem->draw(painter);
        }

        if (_panAutomationItem && _panAutomationItem->showEnvelopes() == true && _automationSelected == Automation::AutomationType_Pan && _rowsExpandedCount > 2) {
            QRect tempRect = _rect;
            tempRect.setTop(offset + rect().top() + _areaInfo->titleHeight());
            tempRect.setHeight(_areaInfo->titleHeight() * (_rowsExpandedCount - 1));
            _panAutomationItem->setRect(tempRect);
            _panAutomationItem->automation()->update(tempRect);
            _panAutomationItem->draw(painter);
        }
    } else {
        if (_volumeAutomationItem && _volumeAutomationItem->showEnvelopes() == true && _automationSelected == Automation::AutomationType_Volume && _rowsExpandedCount > 2) {
            QRect tempRect = _rect;
            tempRect.setTop(offset + rect().top() + _areaInfo->titleHeight());
            tempRect.setHeight(_areaInfo->titleHeight() * (_rowsExpandedCount - 1));
            _volumeAutomationItem->setRect(tempRect);
            _volumeAutomationItem->automation()->update(tempRect);
            _volumeAutomationItem->draw(painter);
        }

        if (_panAutomationItem && _panAutomationItem->showEnvelopes() == true && _automationSelected == Automation::AutomationType_Pan && _rowsExpandedCount > 2) {
            QRect tempRect = _rect;
            tempRect.setTop(offset + rect().top() + _areaInfo->titleHeight());
            tempRect.setHeight(_areaInfo->titleHeight() * (_rowsExpandedCount - 1));
            _panAutomationItem->setRect(tempRect);
            _panAutomationItem->automation()->update(tempRect);
            _panAutomationItem->draw(painter);
        }

        auto top = rect().top() + _rowsExpandedCount * _areaInfo->titleHeight() + _areaInfo->seperatorHeight();
        for (int i = 0; i < _automationLaneModel->count(); i++) {
            auto item = _automationLaneModel->getItem(i);

            if (item->automationLaneControl == "Pan" && _rowsExpandedCount > 2 && _panAutomationItem->showEnvelopes() == true) {

                auto H = _automationLaneModel->totalRowCountBefore2(i) * _areaInfo->titleHeight() + i * _areaInfo->seperatorHeight();

                auto tempRect = _rect;
                tempRect.setTop(offset + top + H);
                tempRect.setHeight(_automationLaneModel->getItem(i)->automationLaneRowCount * _areaInfo->titleHeight());

                _panAutomationItem->setRect(tempRect);
                _panAutomationItem->automation()->update(tempRect);
                _panAutomationItem->draw(painter);
            }

            if (item->automationLaneControl == "Volume" && _rowsExpandedCount > 2 && _volumeAutomationItem->showEnvelopes() == true) {
                auto H = _automationLaneModel->totalRowCountBefore2(i) * _areaInfo->titleHeight() + i * _areaInfo->seperatorHeight();

                auto tempRect = _rect;
                tempRect.setTop(offset + top + H);
                tempRect.setHeight(_automationLaneModel->getItem(i)->automationLaneRowCount * _areaInfo->titleHeight());

                _volumeAutomationItem->setRect(tempRect);
                _volumeAutomationItem->automation()->update(tempRect);
                _volumeAutomationItem->draw(painter);
            }
        }
    }

    _keyFramesItem->draw(painter);

    _objectPositionX->draw(event);
    _objectPositionY->draw(event);
    _objectPositionZ->draw(event);
}

void TrackItem::drawAutomationLane(IPainter* painter)
{

    auto offset = 0;

    painter->save();
    painter->beginPath();
    painter->setStrokeStyle("#2f3032");
    painter->setFillStyle("#2f3032");
    auto top = TrackItem::rect().y() + TrackItem::rect().height();
    for (int i = 0; i < _automationLaneModel->count(); i++) {
        auto H = _automationLaneModel->totalRowCountBefore2(i) * _areaInfo->titleHeight() + i * _areaInfo->seperatorHeight();
        painter->fillRect(rect().x(), offset + top + H + _automationLaneModel->getItem(i)->automationLaneRowCount * _areaInfo->titleHeight(), rect().width(), _areaInfo->seperatorHeight());
    }
    painter->fill();
    painter->restore();
}
void TrackItem::drawClips(IPainter* painter)
{
    _mutex.lock();

    if (_clipItems.contains(_selectedClipIndex)) {
        if (_clipItems[_selectedClipIndex])
            _clipItems[_selectedClipIndex]->draw(painter);
    }

    QMapIterator<QString, ClipItem*> i(_clipItems);
    while (i.hasNext()) {
        i.next();

        if (i.value() == nullptr)
            continue;

        if (i.key() == _selectedClipIndex)
            continue;

        i.value()->draw(painter);
    }

    _mutex.unlock();
}

void TrackItem::drawIndicator(IPainter* painter)
{
    auto offset = 0;

    int Y = rect().top() + offset;
    auto top = rect().top() + _rowsExpandedCount * _areaInfo->titleHeight() + _areaInfo->seperatorHeight() + offset;

    if (_indicatorEnabled == IndicatorType_Track) {
        painter->beginPath();
        painter->setStrokeStyle(_indicatorColor);

        double currentPix = ((_currentIndicator - _areaInfo->startTime()) / (double)_areaInfo->clipDuration()) * _areaInfo->lastWidth();

        painter->moveTo(currentPix, Y);
        painter->lineTo(currentPix, Y + rect().height());
        painter->stroke();
    }
    if (_indicatorEnabled == IndicatorType_VolumeLane) {
        painter->beginPath();
        painter->setStrokeStyle(_indicatorColor);

        int index = _automationLaneModel->getIndex("Volume");
        if (index >= 0) {
            double currentPix = ((_currentIndicator - _areaInfo->startTime()) / (double)_areaInfo->clipDuration()) * _areaInfo->lastWidth();
            auto H = _automationLaneModel->totalRowCountBefore2(index) * _areaInfo->titleHeight() + index * _areaInfo->seperatorHeight();

            Y = top + H;
            int B = Y + _automationLaneModel->getItem(index)->automationLaneRowCount * _areaInfo->titleHeight();

            painter->moveTo(currentPix, Y);
            painter->lineTo(currentPix, B);
            painter->stroke();
        }
    }

    if (_indicatorEnabled == IndicatorType_PanLane) {
        painter->beginPath();
        painter->setStrokeStyle(_indicatorColor);

        int index = _automationLaneModel->getIndex("Pan");
        if (index >= 0) {
            double currentPix = ((_currentIndicator - _areaInfo->startTime()) / (double)_areaInfo->clipDuration()) * _areaInfo->lastWidth();
            auto H = _automationLaneModel->totalRowCountBefore2(index) * _areaInfo->titleHeight() + index * _areaInfo->seperatorHeight();

            Y = top + H;
            int B = Y + _automationLaneModel->getItem(index)->automationLaneRowCount * _areaInfo->titleHeight();

            painter->moveTo(currentPix, Y);
            painter->lineTo(currentPix, B);
            painter->stroke();
        }
    }
}

void TrackItem::findSnap(double posX, double posY, double& final_xpos, double& final_ypos) // findAutomationPositions
{
    double first = 0;
    double last = 0;

    if (_areaInfo->snapPoints().size() == 0) {
        final_xpos = posX;
        return;
    }

    for (int k = 0; k < _areaInfo->snapPoints().size(); k++) {

        if (_areaInfo->snapPoints()[k].first <= posX && _areaInfo->snapPoints()[k].second >= posX) {

            first = _areaInfo->snapPoints()[k].first;
            last = _areaInfo->snapPoints()[k].second;

            break;
        }
    }

    if (_areaInfo->snapPoints().size() > 0) {
        if (_areaInfo->snapPoints()[_areaInfo->snapPoints().size() - 1].second < posX) {
            final_xpos = _areaInfo->snapPoints()[_areaInfo->snapPoints().size() - 1].second;
            return;
        }

        if (_areaInfo->snapPoints()[0].first > posX && _areaInfo->snapPoints()[0].first >= 0 && posX > 0) {

            final_xpos = _areaInfo->snapPoints()[0].first;
            return;
        }

        if (posX < 0) {
            final_xpos = _areaInfo->snapPoints()[0].first;
            return;
        }

        if (_areaInfo->snapPoints()[0].second > posX && _areaInfo->snapPoints()[0].second >= 0) {

            final_xpos = _areaInfo->snapPoints()[0].first;
            return;
        }
    }

    double mid = (last + first) / 2.0;

    if (posX < mid) {
        final_xpos = first;
    }
    if (posX >= mid) {

        final_xpos = last;
    }
}

void TrackItem::findSnap(QVector<QPair<double, double>> _snapPoints, double posX, double posY, double& final_xpos, double& final_ypos)
{
    double first = 0;
    double last = 0;

    if (_snapPoints.size() == 0) {
        final_xpos = posX;
        return;
    }

    for (int k = 0; k < _snapPoints.size(); k++) {

        if (_snapPoints[k].first <= posX && _snapPoints[k].second >= posX) {

            first = _snapPoints[k].first;
            last = _snapPoints[k].second;
            break;
        }
    }

    if (_snapPoints.size() > 0) {
        if (_snapPoints[_snapPoints.size() - 1].second < posX) {
            final_xpos = _snapPoints[_snapPoints.size() - 1].second;

            return;
        }

        if (_snapPoints[0].first > posX && _snapPoints[0].first >= 0 && posX > 0) {

            final_xpos = _snapPoints[0].first;

            return;
        }

        if (posX < 0) {

            final_xpos = _snapPoints[0].first;

            return;
        }

        if (_snapPoints[0].second > posX && _snapPoints[0].second >= 0) {

            final_xpos = _snapPoints[0].first;

            return;
        }
    }

    double mid = (last + first) / 2.0;

    if (posX < mid) {
        final_xpos = first;
    }
    if (posX >= mid) {
        final_xpos = last;
    }
}

AutomationLaneModel::AutomationLaneModel(AreaInfo* areaInfo, TrackItem* trackItem, QObject* parent)
    : _areaInfo(areaInfo)
    , _trackItem(trackItem)
    , QAbstractListModel(parent)
{
    m_roleNames[ROLE_AutomationLaneIndex] = "AutomationLaneIndex";
    m_roleNames[ROLE_AutomationLaneDevice] = "AutomationLaneDevice";
    m_roleNames[ROLE_AutomationLaneControl] = "AutomationLaneControl";
    m_roleNames[ROLE_AutomationLaneType] = "AutomationLaneType";
    m_roleNames[ROLE_AutomationLaneRowCount] = "AutomationLaneRowCount";
    m_roleNames[ROLE_AutomationLaneHeight] = "AutomationLaneHeight";
    m_roleNames[ROLE_AutomationLaneDisplayText] = "AutomationLaneDisplayText";
    _titleHeight = areaInfo->titleHeight();
    _seperatorHeight = areaInfo->seperatorHeight();
}

void AutomationLaneModel::append(QString automationLaneDevice, QString automationLaneControl, int rowCount)
{
    qDebug() << "automationLaneControl" << automationLaneControl;
    if (automationLaneControl == "Volume") {
        m_automationLanes.append(AutomationLane { m_automationLanes.size(), automationLaneDevice, automationLaneControl, ROLE_AutomationLaneTypeVolume, 3 });
    } else {
        m_automationLanes.append(AutomationLane { m_automationLanes.size(), automationLaneDevice, automationLaneControl, ROLE_AutomationLaneTypePan, 3 });
    }

    Q_EMIT beginResetModel();
    Q_EMIT endResetModel();
    Q_EMIT totalHeightChanged();
    Q_EMIT sigRowAdded(m_automationLanes.size() - 1, rowCount, automationLaneControl);
    Q_EMIT countChanged();
}

void AutomationLaneModel::remove(int index)
{

    if (index >= 0 && index < m_automationLanes.size()) {
        auto count = m_automationLanes[index].automationLaneRowCount;
        auto control = m_automationLanes[index].automationLaneControl;
        m_automationLanes.removeAt(index);

        Q_EMIT beginResetModel();
        Q_EMIT endResetModel();

        Q_EMIT totalHeightChanged();
        Q_EMIT sigRowRemoved(count, control);
        Q_EMIT countChanged();
    }
}

bool AutomationLaneModel::isContained(QString text)
{

    for (int i = 0; i < m_automationLanes.size(); i++) {
        if (m_automationLanes[i].automationLaneControl == text) {
            return true;
        }
    }
    return false;
}

int AutomationLaneModel::count()
{
    return m_automationLanes.size();
}

int AutomationLaneModel::totalHeight()
{
    int height = 0;

    for (int i = 0; i < m_automationLanes.size(); i++) {
        height += (m_automationLanes[i].automationLaneRowCount * _titleHeight) + _seperatorHeight;
    }
    return height;
}

int AutomationLaneModel::getIndex(QPointF point)
{

    auto top = _trackItem->rect().top() + _trackItem->rowsExpandedCount() * _areaInfo->titleHeight() + _areaInfo->seperatorHeight();
    for (int i = 0; i < m_automationLanes.size(); i++) {
        auto H = totalRowCountBefore2(i) * _areaInfo->titleHeight() + i * _areaInfo->seperatorHeight();
        auto tempRect = _trackItem->rect();
        tempRect.setTop(top + H);
        tempRect.setHeight(getItem(i)->automationLaneRowCount * _areaInfo->titleHeight() + _areaInfo->seperatorHeight());
        if (tempRect.contains(point.toPoint())) {
            return i;
        }
    }
    return -1;
}

int AutomationLaneModel::totalRowCount()
{
    int count = 0;
    for (int i = 0; i < m_automationLanes.size(); i++) {
        count += (m_automationLanes[i].automationLaneRowCount);
    }
    return count;
}

int AutomationLaneModel::totalRowCountBefore(int _index)
{
    int count = 0;
    for (int i = 0; i <= _index; i++) {
        count += (m_automationLanes[i].automationLaneRowCount);
    }
    return count;
}
int AutomationLaneModel::totalRowCountBefore2(int _index)
{
    int count = 0;
    for (int i = 0; i < _index; i++) {
        count += (m_automationLanes[i].automationLaneRowCount);
    }
    return count;
}

void AutomationLaneModel::decrease(int i)
{
    if (m_automationLanes[i].automationLaneRowCount > 1) {
        m_automationLanes[i].automationLaneRowCount--;
        Q_EMIT sigRowChanged();
        Q_EMIT dataChanged(QAbstractListModel::index(i, 0), QAbstractListModel::index(i, 0), QVector<int>() << ROLE_AutomationLaneHeight);
        Q_EMIT totalHeightChanged();
    }
}

void AutomationLaneModel::increase(int i)
{
    m_automationLanes[i].automationLaneRowCount++;
    Q_EMIT sigRowChanged();
    Q_EMIT dataChanged(QAbstractListModel::index(i, 0), QAbstractListModel::index(i, 0), QVector<int>() << ROLE_AutomationLaneHeight);
    Q_EMIT totalHeightChanged();
}

void AutomationLaneModel::setLaneHeight(int _index, int posY)
{

    if (_index >= 0 && _index < m_automationLanes.size() - 1) {
        auto startY = totalRowCountBefore(_index) * _areaInfo->titleHeight() + _trackItem->rect().bottom() + _areaInfo->seperatorHeight();

        auto diff = posY - startY;

        if (diff > _areaInfo->titleHeight()) {

            m_automationLanes[_index].automationLaneRowCount++;

        } else if (diff < -_areaInfo->titleHeight()) {

            if (m_automationLanes[_index].automationLaneRowCount > 1) {
                m_automationLanes[_index].automationLaneRowCount--;
            }
        }

        Q_EMIT sigRowChanged();
        Q_EMIT dataChanged(QAbstractListModel::index(_index, 0), QAbstractListModel::index(_index, 0), QVector<int>() << ROLE_AutomationLaneHeight);
        Q_EMIT dataChanged(QAbstractListModel::index(_index + 1, 0), QAbstractListModel::index(_index + 1, 0), QVector<int>() << ROLE_AutomationLaneHeight);
        Q_EMIT dataChanged(QAbstractListModel::index(_index + 1, 0), QAbstractListModel::index(_index + 1, 0), QVector<int>() << ROLE_AutomationLaneRowCount);
        Q_EMIT dataChanged(QAbstractListModel::index(_index, 0), QAbstractListModel::index(_index, 0), QVector<int>() << ROLE_AutomationLaneRowCount);

    } else if (_index == m_automationLanes.size() - 1) {

        auto startY = totalRowCountBefore(_index) * _areaInfo->titleHeight() + _trackItem->rect().bottom() + _areaInfo->seperatorHeight();

        auto diff = posY - startY;

        if (diff > _areaInfo->titleHeight()) {

            m_automationLanes[_index].automationLaneRowCount++;

        } else if (diff < -_areaInfo->titleHeight()) {

            if (m_automationLanes[_index].automationLaneRowCount > 1) {
                m_automationLanes[_index].automationLaneRowCount--;
            }
        }

        Q_EMIT sigRowChanged();
        Q_EMIT dataChanged(QAbstractListModel::index(_index, 0), QAbstractListModel::index(_index, 0), QVector<int>() << ROLE_AutomationLaneHeight);
        Q_EMIT dataChanged(QAbstractListModel::index(_index, 0), QAbstractListModel::index(_index, 0), QVector<int>() << ROLE_AutomationLaneRowCount);
    }
}

void AutomationLaneModel::updateLanesHeight()
{
    for (int i = 0; i < m_automationLanes.size(); i++) {
        Q_EMIT dataChanged(QAbstractListModel::index(i, 0), QAbstractListModel::index(i, 0), QVector<int>() << ROLE_AutomationLaneHeight);
    }
}

QHash<int, QByteArray> AutomationLaneModel::roleNames() const
{
    return m_roleNames;
}

int AutomationLaneModel::rowCount(const QModelIndex& parent) const
{
    return m_automationLanes.size();
}

QVariant AutomationLaneModel::data(const QModelIndex& index, int role) const
{

    if (!index.isValid())
        return QVariant();

    if (m_automationLanes.size() == 0 || index.row() < 0)
        return QVariant();

    AutomationLane value = m_automationLanes[index.row()];

    switch (role) {
    case ROLE_AutomationLaneIndex:
        return value.automationLaneIndex;
    case ROLE_AutomationLaneDevice:
        return value.automationLaneDevice;
    case ROLE_AutomationLaneControl:
        return value.automationLaneControl;
    case ROLE_AutomationLaneDisplayText:
        return value.automationLaneControl;
    case ROLE_AutomationLaneType:
        return value.automationLaneType;
    case ROLE_AutomationLaneRowCount:
        return value.automationLaneRowCount;
    case ROLE_AutomationLaneHeight:
        return m_automationLanes[index.row()].automationLaneRowCount * _areaInfo->titleHeight() + _areaInfo->seperatorHeight();
    }
    return QVariant();
}
